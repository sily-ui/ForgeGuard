# ForgeGuard 后端环境变量模板：复制为 .env 并填入真实值。
# 真实 .env 已被 .gitignore 忽略，密钥不会进入版本库、代码与日志。
# 模型接口（不配置则使用离线仿真推理）
MODEL_API_KEY=your-model-api-key
MODEL_BASE_URL=https://your-llm-provider.example.com/v2
MODEL_NAME=your-model-name
# 可选：监护模型与业务模型分离
GUARDIAN_MODEL_NAME=your-guardian-model-name

# 可选：自定义访问口令（JSON 数组）。不配置时使用内置演示口令，
# /api/v1/health 会返回 insecure_demo_mode=true 作为告警。
# ACCESS_PASSCODES=[{"passcode":"your-passcode","role":"admin","one_time":false,"expires_at":null}]

# 可选：配额与实例上限
# QUOTA_GLOBAL_DAILY=1000
# QUOTA_SESSION_MAX=60
# INSTANCE_MAX=8
# SESSION_TTL=14400