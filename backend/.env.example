# ForgeGuard 后端环境变量模板：复制为 .env 并填入真实值。
# 真实 .env 已被 .gitignore 忽略，密钥不会进入版本库、代码与日志。
# 模型接口（不配置则使用离线仿真推理）
MODEL_API_KEY=your-model-api-key
MODEL_BASE_URL=https://your-llm-provider.example.com/v2
MODEL_NAME=your-model-name
# 可选：监护模型与业务模型分离
GUARDIAN_MODEL_NAME=your-guardian-model-name

# 可选：备用模型。主模型额度耗尽、限流或上游不可达时，后端自动切换到备用模型，
# 对前端与业务侧透明（会话仍走同一套配额与判定链路）。不配置则只有主模型一档。
FALLBACK_MODEL_API_KEY=your-fallback-api-key
FALLBACK_MODEL_BASE_URL=https://your-fallback-provider.example.com/v1
FALLBACK_MODEL_NAME=your-fallback-model-name

# 可选：配额与实例上限
# QUOTA_GLOBAL_DAILY=1000
# QUOTA_SESSION_MAX=60
# 游客匿名准入：每工作区每日模型调用上限 / 同一 IP 每日总量上限
# QUOTA_GUEST_DAILY=20
# QUOTA_GUEST_IP_DAILY=60
# INSTANCE_MAX=8
# SESSION_TTL=14400

# 可选：管理员引导密钥。配置后 POST /api/v1/auth/admin 凭此密钥换取 admin 令牌；
# 留空则管理员准入关闭（配额调整/快照切换/清理等管理操作不可达）。
# ADMIN_BOOTSTRAP_KEY=

# 可选：部署在可信反向代理（Nginx 等）之后时置 true，
# 按 X-Forwarded-For 首个地址识别客户端 IP，保证 IP 维度限流/配额准确。
# TRUST_PROXY_HEADERS=false